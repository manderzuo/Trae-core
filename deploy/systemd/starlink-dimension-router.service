[Unit]
Description=Starlink Dimension Router API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/var/lib/starlink-dimension-router
StateDirectory=starlink-dimension-router
StateDirectoryMode=0750
Environment=STARLINK_ROUTER_DATA_DIR=/var/lib/starlink-dimension-router
EnvironmentFile=/etc/starlink-dimension-router/key-encryption.env
Environment=STARLINK_ROUTER_HOST=127.0.0.1
Environment=STARLINK_ROUTER_PORT=17865
Environment=STARLINK_ROUTER_PUBLIC_BASE_URL=https://api.gemstory.cn
ExecStart=/opt/gemstory/starlink-dimension-router/releases/20260923-c3a80826/starlink-dimension-router
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
